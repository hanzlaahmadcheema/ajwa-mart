---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import { site, meta } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = meta.title, description = meta.description } = Astro.props;
const canonical = `${site.url}/`;
const ogImage = `${site.url}/og-image.jpg`;
const ogImageSquare = `${site.url}/og-image-square.jpg`;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': ['GroceryStore', 'Bakery', 'FastFoodRestaurant'],
  name: site.name,
  alternateName: 'اجوہ مارٹ',
  image: ogImage,
  telephone: '+92 300 1827927',
  priceRange: 'PKR',
  currenciesAccepted: 'PKR',
  paymentAccepted: 'Cash',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.streetAddress,
    addressLocality: site.city,
    addressRegion: site.region,
    postalCode: site.postalCode,
    addressCountry: 'PK',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 30.525,
    longitude: 72.693,
  },
  hasMap: site.mapsSearchUrl,
  url: site.url,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Saturday', 'Sunday'],
      opens: '06:00',
      closes: '23:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Friday',
      opens: '06:00',
      closes: '13:15',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Friday',
      opens: '14:15',
      closes: '23:00',
    },
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ajwa Mart" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_PK" />

    <!-- Open Graph Images (Primary 1200x630 card & WhatsApp/Mobile 600x600 square) -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ajwa Mart — Groceries, Bakery & Sweets, and Fast Food on Okanwala Road, Chichawatni" />

    <meta property="og:image" content={ogImageSquare} />
    <meta property="og:image:secure_url" content={ogImageSquare} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content="Ajwa Mart Logo — Okanwala Road, Chichawatni" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Ajwa Mart — Groceries, Bakery & Sweets, and Fast Food on Okanwala Road, Chichawatni" />

    <!-- Icons -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="theme-color" content="#1C110C" />

    <!-- Self-hosted fonts: preload the two critical weights, then the rest -->
    <link rel="preload" href="/fonts/oswald-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts-local.css" />

    <script type="application/ld+json" set:html={jsonLd} />
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
    <script src="../scripts/main.ts"></script>
  </body>
</html>
