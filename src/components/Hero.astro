---
import { site } from '../data/site';
import StarShine from './StarShine.astro';
---

<section id="home" class="pattern-light scroll-mt-24" aria-labelledby="hero-heading">
  <StarShine tone="light" uid="spark-hero" />
  <div class="container-x grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:py-20">
    <div>
      <p class="eyebrow anim-fade">Chichawatni &bull; Punjab, Pakistan</p>
      <h1
        id="hero-heading"
        class="anim-rise mt-3 font-display text-6xl font-bold uppercase leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl"
      >
        Ajwa <span class="text-brand-maroon">Mart</span>
      </h1>
      <p class="anim-rise anim-d1 mt-5 max-w-xl text-lg leading-relaxed text-brand-muted">
        Your local destination for everyday shopping — groceries, bakery &amp; sweets, and fast
        food, all under one roof in the heart of Chichawatni.
      </p>

      <ul class="anim-rise anim-d2 mt-6 flex flex-wrap gap-2.5" aria-label="What we offer">
        {
          ['Groceries', 'Bakery & Sweets', 'Fast Food'].map((item) => (
            <li class="inline-flex items-center gap-2 rounded-full border border-brand-border bg-white px-4 py-2 text-sm font-semibold text-brand-brown shadow-sm">
              <span class="h-2 w-2 rounded-full bg-brand-green" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>

      <p
        id="open-badge"
        class="anim-rise anim-d3 mt-6 inline-flex items-center gap-2 rounded-full bg-brand-green-soft px-4 py-2 text-sm font-semibold text-brand-brown"
        role="status"
      >
        <span class="h-2.5 w-2.5 rounded-full bg-brand-green" aria-hidden="true"></span>
        Open daily &middot; 6:00 AM – 11:00 PM
      </p>

      <div class="anim-rise anim-d4 mt-6 flex flex-col gap-3 sm:flex-row">
        <a href="#visit" class="btn bg-brand-yellow text-brand-brown shadow-sm hover:bg-brand-yellow-deep">
          Visit Us
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" />
          </svg>
        </a>
        <a
          href={site.phoneHref}
          class="btn border-2 border-brand-brown bg-white text-brand-brown hover:bg-brand-brown hover:text-white"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          Call {site.phoneDisplay}
        </a>
      </div>
    </div>

    <div class="mx-auto w-full max-w-md lg:max-w-none">
      <picture class="anim-photo anim-d2 block">
        <source srcset="/hero.webp" type="image/webp" />
        <img
          src="/hero.jpg"
          alt="Inside Ajwa Mart — shelves stocked with groceries, bakery and sweets in Chichawatni"
          width="1448"
          height="1086"
          class="h-auto w-full rounded-3xl object-cover shadow-lift"
          fetchpriority="high"
        />
      </picture>
      <div class="anim-rise anim-d3 mt-4 grid grid-cols-2 gap-3" aria-label="Quick store details">
        <div class="flex items-center gap-3 rounded-2xl border border-brand-border bg-white px-4 py-3 shadow-sm">
          <svg class="h-5 w-5 shrink-0 text-brand-maroon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
          </svg>
          <div class="text-sm">
            <span class="sr-only">Opening hours: </span>
            <p class="font-semibold leading-tight">6:00 AM – 11:00 PM</p>
            <p class="text-brand-muted">Every day</p>
          </div>
        </div>
        <div class="flex items-center gap-3 rounded-2xl border border-brand-border bg-white px-4 py-3 shadow-sm">
          <svg class="h-5 w-5 shrink-0 text-brand-maroon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" />
          </svg>
          <div class="text-sm">
            <span class="sr-only">Location: </span>
            <p class="font-semibold leading-tight">Okanwala Road</p>
            <p class="text-brand-muted">Chichawatni, Punjab</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
