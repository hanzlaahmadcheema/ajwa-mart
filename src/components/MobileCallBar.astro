---
import { site } from '../data/site';
---

<!--
  Mobile-only sticky action bar: the two things a local customer needs most —
  calling the store and getting directions — always one tap away.
  Hidden on md+ screens, where the header CTA covers it.
-->
<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-brand-border bg-white/95 backdrop-blur md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom, 0px);"
  role="region"
  aria-label="Quick actions"
>
  <div class="grid grid-cols-2 gap-3 p-3">
    <a
      href={site.phoneHref}
      class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-xl bg-brand-yellow font-display text-base font-semibold uppercase tracking-wide text-brand-brown"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
      </svg>
      Call
    </a>
    <a
      href={site.mapsSearchUrl}
      target="_blank"
      rel="noopener"
      class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-xl bg-brand-maroon font-display text-base font-semibold uppercase tracking-wide text-white"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" />
      </svg>
      Directions
    </a>
  </div>
</div>
