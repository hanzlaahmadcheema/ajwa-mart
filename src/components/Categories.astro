---
const categories = [
  {
    title: 'General Store',
    text: 'Everyday groceries and household essentials — your regular shopping, close to home.',
    icon: '<path d="m15 11-1 9"/><path d="m19 11-4-7"/><path d="M2 11h20"/><path d="m3.5 11 1.6 7.4a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6l1.7-7.4"/><path d="m9 11 1 9"/><path d="M4.5 15.5h15"/><path d="m5 11 4-7"/>',
  },
  {
    title: 'Bakery & Sweets',
    text: 'Bakery items and sweets for everyday treats, family occasions, and guests.',
    icon: '<path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"/><path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1"/><path d="M2 21h20"/><path d="M7 8v3"/><path d="M12 8v3"/><path d="M17 8v3"/><path d="M7 4h.01"/><path d="M12 4h.01"/><path d="M17 4h.01"/>',
  },
  {
    title: 'Fast Food',
    text: 'Hot, prepared food for takeaway — a quick, easy meal when you&rsquo;re on the go.',
    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  },
];
---

<section id="offer" class="scroll-mt-24" aria-labelledby="offer-heading">
  <div class="container-x py-16 sm:py-20 lg:py-24">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">What we offer</p>
      <h2 id="offer-heading" class="mt-3 font-display text-4xl font-semibold uppercase tracking-tight sm:text-5xl">
        Our Counters: Groceries, Bakery, Sweets &amp; Fast Food
      </h2>
      <p class="mt-4 leading-relaxed text-brand-muted">
        Ajwa Mart brings together the three things a busy household reaches for most —
        so you can finish your errands in a single stop.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((cat, i) => (
          <article
            data-reveal
            style={`--reveal-delay: ${i * 100}ms`}
            class="group rounded-3xl border border-brand-border bg-white p-7 shadow-card transition-all duration-200 hover:-translate-y-1 hover:shadow-lift"
          >
            <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-yellow-soft text-brand-maroon" aria-hidden="true">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={cat.icon} />
            </span>
            <h3 class="mt-5 font-display text-2xl font-semibold uppercase tracking-wide">{cat.title}</h3>
            <p class="mt-2.5 leading-relaxed text-brand-muted" set:html={cat.text} />
          </article>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-brand-muted">
      Looking for something specific? Call us at
      <a href="tel:+923001827927" class="whitespace-nowrap font-semibold text-brand-maroon underline underline-offset-2 hover:text-brand-maroon-deep">0300 1827927</a>
      and we&rsquo;ll let you know if it&rsquo;s on our shelves.
    </p>
  </div>
</section>
