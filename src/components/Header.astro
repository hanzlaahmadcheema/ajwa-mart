---
import { site, navLinks } from '../data/site';
---

<header class="sticky top-0 z-50 border-b border-brand-border bg-white/95 backdrop-blur">
  <div class="container-x flex h-[72px] items-center justify-between gap-4">
    <a href="#home" class="flex items-center gap-3" aria-label="Ajwa Mart Chichawatni — Home">
      <picture>
        <source srcset="/logo.webp" type="image/webp" />
        <img
          src="/logo.png"
          alt=""
          width="48"
          height="48"
          class="h-12 w-12"
          fetchpriority="high"
        />
      </picture>
      <span class="leading-none">
        <span class="block font-display text-xl font-semibold uppercase tracking-wide">Ajwa Mart</span>
        <span class="mt-1 block text-[10px] font-semibold uppercase tracking-[0.28em] text-brand-muted">
          Chichawatni
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-navlink
            class="text-sm font-semibold text-brand-brown/80 transition-colors hover:text-brand-maroon"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={site.phoneHref}
        class="btn hidden !min-h-[44px] !px-5 !py-2 !text-sm bg-brand-yellow text-brand-brown shadow-sm hover:bg-brand-yellow-deep md:inline-flex"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        Call Now
      </a>
      <button
        id="menu-btn"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-brand-border text-brand-brown md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" />
        </svg>
        <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="hidden border-t border-brand-border bg-white md:hidden" aria-label="Mobile">
    <div class="container-x flex flex-col gap-1 py-4">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-3 font-display text-base font-medium uppercase tracking-wide text-brand-brown hover:bg-brand-cream"
          >
            {link.label}
          </a>
        ))
      }
      <div class="mt-2 grid grid-cols-2 gap-3">
        <a href={site.phoneHref} class="btn !px-4 bg-brand-yellow text-brand-brown hover:bg-brand-yellow-deep">
          Call Now
        </a>
        <a
          href={site.mapsSearchUrl}
          target="_blank"
          rel="noopener"
          class="btn !px-4 border-2 border-brand-brown text-brand-brown hover:bg-brand-brown hover:text-white"
        >
          Directions
        </a>
      </div>
    </div>
  </nav>
</header>
