---
/**
 * Gallery placeholders.
 *
 * No authentic Ajwa Mart photos were supplied with the build, so the grid
 * below uses clearly marked placeholders. Replace each tile with a real,
 * owner-provided photo (optimised, with descriptive alt text) — never
 * present stock imagery as if it were Ajwa Mart.
 */
const placeholders = Array.from({ length: 6 });
---

<section id="gallery" class="scroll-mt-24 bg-white" aria-labelledby="gallery-heading">
  <div class="container-x py-16 sm:py-20 lg:py-24">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">Gallery</p>
      <h2 id="gallery-heading" class="mt-3 font-display text-4xl font-semibold uppercase tracking-tight sm:text-5xl">
        Inside Ajwa Mart
      </h2>
      <p class="mt-4 leading-relaxed text-brand-muted">
        Real photos of the store, the bakery counter, and our food are on their way —
        this space is reserved for them.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-3">
      {
        placeholders.map((_, i) => (
          <div
            role="img"
            aria-label={`Gallery photo ${i + 1} coming soon — reserved for a real Ajwa Mart photo`}
            data-reveal
            style={`--reveal-delay: ${(i % 3) * 80}ms`}
            class="lift flex aspect-[4/3] flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-brand-border bg-brand-cream p-4 text-center"
          >
            <svg class="h-8 w-8 text-brand-muted/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" />
              <circle cx="12" cy="13" r="3" />
            </svg>
            <p class="text-sm font-semibold text-brand-muted">Photo coming soon</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
