---
import { site, hours } from '../data/site';
---

<section id="visit" class="scroll-mt-24 bg-white" aria-labelledby="visit-heading">
  <div class="container-x py-16 sm:py-20 lg:py-24">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">Visit us</p>
      <h2 id="visit-heading" class="mt-3 font-display text-4xl font-semibold uppercase tracking-tight sm:text-5xl">
        Find us in Chichawatni
      </h2>
      <p class="mt-4 leading-relaxed text-brand-muted">
        Drop by for your daily shopping, call ahead, or get directions — we&rsquo;re easy to reach.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="lift rounded-3xl border border-brand-border bg-brand-cream p-6 shadow-card sm:p-8" data-reveal>
        <ul class="space-y-6">
          <li class="flex gap-4">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand-yellow-soft text-brand-maroon" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            <div>
              <h3 class="font-display text-lg font-semibold uppercase tracking-wide">Address</h3>
              <p class="mt-1 text-brand-muted">
                <strong class="font-semibold text-brand-brown">{site.name}</strong><br />
                {site.addressLine}
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand-yellow-soft text-brand-maroon" aria-hidden="true">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </span>
            <div>
              <h3 class="font-display text-lg font-semibold uppercase tracking-wide">Phone</h3>
              <p class="mt-1">
                <a href={site.phoneHref} class="text-xl font-bold text-brand-maroon underline-offset-4 hover:underline">
                  {site.phoneDisplay}
                </a>
              </p>
            </div>
          </li>
        </ul>

        <div class="mt-7 grid gap-3 sm:grid-cols-2">
          <a href={site.phoneHref} class="btn bg-brand-yellow text-brand-brown hover:bg-brand-yellow-deep">
            Call Now
          </a>
          <a
            href={site.mapsSearchUrl}
            target="_blank"
            rel="noopener"
            class="btn bg-brand-maroon text-white hover:bg-brand-maroon-deep"
          >
            Get Directions
          </a>
        </div>
      </div>

      <div class="overflow-hidden rounded-3xl border border-brand-border shadow-card" data-reveal style="--reveal-delay: 120ms">
        <iframe
          src={site.mapsEmbedUrl}
          title="Map showing Ajwa Mart in Chichawatni, Punjab, Pakistan"
          class="h-full min-h-[340px] w-full"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <div class="mt-6 rounded-3xl border border-brand-border bg-brand-cream p-6 shadow-card sm:p-8" data-reveal>
      <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
        <div class="md:max-w-xs">
          <h3 class="font-display text-xl font-semibold uppercase tracking-wide">Opening hours</h3>
          <p class="mt-2 text-sm leading-relaxed text-brand-muted">
            Hours below follow public directory listings. If anything changes, this is the
            first place we&rsquo;ll update.
          </p>
        </div>
        <dl class="w-full max-w-xl divide-y divide-brand-border">
          {
            hours.map((row) => (
              <div class="flex flex-col gap-1 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-baseline sm:justify-between">
                <dt class="font-semibold">{row.days}</dt>
                <dd class="text-brand-muted sm:text-right">
                  {row.time}
                  {row.note && <span class="block text-sm italic">{row.note}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
