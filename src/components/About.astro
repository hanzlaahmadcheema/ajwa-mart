---
import { site } from '../data/site';

const facts = [
  {
    label: 'Location',
    value: site.addressLine,
  },
  {
    label: 'Phone',
    value: site.phoneDisplay,
  },
  {
    label: 'Hours',
    value: '6:00 AM – 11:00 PM, every day',
  },
  {
    label: 'Services',
    value: 'Takeaway & delivery options as listed publicly',
  },
];

const points = [
  'General store, bakery & sweets, and fast food under one roof',
  'Open long hours — 6:00 AM to 11:00 PM, seven days a week',
  'A convenient, easy-to-reach stop on Okanwala Road, Chichawatni',
];
---

<section id="about" class="scroll-mt-24 bg-white" aria-labelledby="about-heading">
  <div class="container-x grid gap-10 py-16 sm:py-20 lg:grid-cols-2 lg:gap-14 lg:py-24">
    <div data-reveal>
      <p class="eyebrow">About</p>
      <h2 id="about-heading" class="mt-3 font-display text-4xl font-semibold uppercase tracking-tight sm:text-5xl">
        General Store &amp; Grocery in Chichawatni
      </h2>
      <p class="mt-5 leading-relaxed text-brand-muted">
        Ajwa Mart is a neighbourhood general store on Okanwala Road in Chichawatni, Punjab — a convenient stop
        for everyday groceries and household essentials. Alongside the shelves, you&rsquo;ll
        find a bakery &amp; sweets counter and fast food for takeaway, so one visit can cover
        the day&rsquo;s shopping and a quick meal.
      </p>
      <p class="mt-4 leading-relaxed text-brand-muted">
        We keep long hours, seven days a week, so you can shop on your schedule — early
        morning or late evening.
      </p>
      <ul class="mt-6 space-y-3">
        {
          points.map((point) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-green-soft" aria-hidden="true">
                <svg class="h-3.5 w-3.5 text-brand-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <span class="font-medium">{point}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:pl-4" data-reveal style="--reveal-delay: 120ms">
      <div class="lift rounded-3xl border border-brand-border bg-brand-cream p-6 shadow-card sm:p-8">
        <h3 class="font-display text-xl font-semibold uppercase tracking-wide">At a glance</h3>
        <dl class="mt-5 space-y-5">
          {
            facts.map((fact) => (
              <div class="flex gap-4 border-b border-brand-border pb-5 last:border-0 last:pb-0">
                <dt class="w-20 shrink-0 text-sm font-semibold uppercase tracking-wide text-brand-maroon">
                  {fact.label}
                </dt>
                <dd class="text-[15px] leading-relaxed">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
        <a
          href={site.phoneHref}
          class="btn mt-7 w-full bg-brand-brown text-white hover:bg-brand-maroon"
        >
          Call {site.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</section>
